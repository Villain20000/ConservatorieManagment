generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  DIRECTOR
  ADMINISTRATOR
  TEACHER
  STUDENT
  GUARDIAN
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  ARCHIVED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum LessonType {
  INDIVIDUAL
  GROUP
  ENSEMBLE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SeriesStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum ExamType {
  PERIODIC
  PROMOTION
  GRADUATION
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  GRADING
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum ExamOutcome {
  PENDING
  PASS
  FAIL
}

enum AssignmentStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_BOOKED
  TRIAL_COMPLETED
  OFFER_SENT
  ENROLLED
  LOST
}

enum LeadSource {
  WEB_FORM
  PHONE
  WALK_IN
  REFERRAL
  CAMPAIGN
  SOCIAL
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  TRIAL_SCHEDULED
  FOLLOW_UP
  CONVERSION
}

enum DocumentType {
  REGISTRATION_FORM
  ATTENDANCE_CERTIFICATE
  GRADE_TRANSCRIPT
  CERTIFICATE
  DIPLOMA
  EXAM_RECORD
  OTHER
}

enum DocumentStatus {
  DRAFT
  ISSUED
  ARCHIVED
}

enum NotificationType {
  ANNOUNCEMENT
  LESSON_CHANGED
  LESSON_CANCELLED
  ATTENDANCE
  EXAM_RESULT
  SYSTEM
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  DOCUMENT_ISSUED
  EXAM_APPLICATION_DECIDED
  EXAM_PUBLISHED
  EXAM_RESULT_READY
  ASSIGNMENT_CREATED
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  CRM_LEAD_ASSIGNED
  CRM_FOLLOW_UP_DUE
  CRM_CONVERTED
}

enum NumberScope {
  RECEIPT
  DOCUMENT
}

enum ChargeOrigin {
  TUITION
  REGISTRATION
  EXAM_FEE
  MATERIAL
  OTHER
}

enum ScholarshipType {
  PERCENTAGE
  FIXED
}

enum ScholarshipStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum ExamPeriodStatus {
  PLANNED
  OPEN
  CLOSED
}

enum ExamApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ExamCommitteeRole {
  PRESIDENT
  EXAMINER
  MEMBER
}

enum SignatureStatus {
  NONE
  PENDING
  SIGNED
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// How a calendar day is treated when weekly series are materialised.
/// HOLIDAY/CLOSED days are skipped; make-up lessons may be placed on MAKEUP_DAY.
enum CalendarDayKind {
  HOLIDAY
  CLOSED
  MAKEUP_DAY
}

enum SubscriptionInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum SubscriptionPaymentStatus {
  SUCCEED
  FAILED
  PENDING
}

/// Explicit, time-limited platform support access. There is deliberately no
/// silent impersonation: a grant names the tenant, the reason, the window and
/// is revoked on use or expiry.
enum SupportAccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ConsentPurpose {
  DATA_PROCESSING
  MEDIA_PUBLICATION
  RECORDINGS
  PHOTOGRAPHY
  MARKETING
  THIRD_PARTY_SHARING
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum DsarRequestType {
  ACCESS
  PORTABILITY
  ERASURE
  RECTIFICATION
}

enum DsarRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ───────────────────────────── Platform ─────────────────────────────

model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(10, 2)
  maxStudents  Int
  maxTeachers  Int
  features     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String       @unique
  legalName String?
  taxId     String?
  timezone  String       @default("Europe/Athens")
  locale    String       @default("el")
  status    TenantStatus @default(TRIAL)
  logoUrl   String?
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  subscription   Subscription?
  branches       Branch[]
  memberships    Membership[]
  academicYears  AcademicYear[]
  programs       Program[]
  levels         Level[]
  rooms          Room[]
  students       Student[]
  teachers       Teacher[]
  guardians      Guardian[]
  studentGuardians StudentGuardian[]
  enrollments    Enrollment[]
  lessonSeries   LessonSeries[]
  lessonSeriesStudents LessonSeriesStudent[]
  lessons        Lesson[]
  lessonStudents LessonStudent[]
  attendances    Attendance[]
  lessonNotes    LessonNote[]
  announcements  Announcement[]
  notifications  Notification[]
  charges        Charge[]
  payments       Payment[]
  paymentAllocations PaymentAllocation[]
  installmentPlans InstallmentPlan[]
  scholarships   Scholarship[]
  numberSequences NumberSequence[]
  storedFiles    StoredFile[]
  exams          Exam[]
  examPeriods    ExamPeriod[]
  examCommitteeMembers ExamCommitteeMember[]
  examApplications ExamApplication[]
  examResults    ExamResult[]
  documents      DocumentRecord[]
  outboxMessages OutboxMessage[]
  auditLogs      AuditLog[]
  calendarDays   CalendarDay[]
  supportGrants  SupportAccessGrant[]
  consentEvents  ConsentEvent[]
  dsarRequests   DsarRequest[]
  idempotencyKeys IdempotencyKey[]
  assignments     Assignment[]
  assignmentTargets AssignmentTarget[]
  assignmentSubmissions AssignmentSubmission[]
  leads           Lead[]
  leadActivities  LeadActivity[]

  @@map("tenants")
}

model Subscription {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @unique @db.Uuid
  planId           String             @db.Uuid
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

/// SaaS-provider revenue record. Kept strictly separate from conservatory
/// tuition ledgers (section 9B): it belongs to MusicOS, not to the tenant.
model SubscriptionInvoice {
  id             String                    @id @default(uuid(7)) @db.Uuid
  subscriptionId String                    @db.Uuid
  /// Provider-agnostic external key, unique so that replays are harmless.
  externalId     String                    @unique
  number         String
  periodStart    DateTime
  periodEnd      DateTime
  subtotalCents  Int
  taxCents       Int                       @default(0)
  totalCents     Int
  currency       String                    @default("EUR")
  status         SubscriptionInvoiceStatus @default(OPEN)
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  subscription Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@unique([subscriptionId, number])
  @@index([status, dueAt])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id          String                    @id @default(uuid(7)) @db.Uuid
  invoiceId   String                    @db.Uuid
  externalId  String                    @unique
  amountCents Int
  currency    String                    @default("EUR")
  status      SubscriptionPaymentStatus @default(SUCCEED)
  method      String?
  failureCode String?
  attemptedAt DateTime                  @default(now())

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, attemptedAt])
  @@map("subscription_payments")
}

/// A dated exception to the weekly timetable, per tenant: public holidays,
/// closures, or days on which make-up lessons are allowed.
model CalendarDay {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @db.Uuid
  branchId  String?         @db.Uuid
  date      DateTime        @db.Date
  kind      CalendarDayKind
  name      String
  createdAt DateTime        @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, date, kind], map: "calendar_days_tenantId_branchId_date_kind_key")
  @@index([tenantId, date])
  @@map("calendar_days")
}

// The live index `calendar_days_tenantId_branchId_date_kind_key` is declared
// with NULLS NOT DISTINCT so two tenant-wide rules (branchId IS NULL) collide.
// Prisma has no attribute for that modifier; the index is created in migration
// 20261025100000 and must not be regenerated by `migrate diff`.

model SupportAccessGrant {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @db.Uuid
  actorId     String              @db.Uuid
  reason      String
  ticketRef   String?
  status      SupportAccessStatus @default(ACTIVE)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  revokedById String?             @db.Uuid
  createdAt   DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation("SupportGrantActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, expiresAt])
  @@map("support_access_grants")
}

/// Append-only consent ledger. The booleans on Student are a projection of the
/// latest event, which is what a supervisory authority expects to be able to trace.
model ConsentEvent {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  studentId    String         @db.Uuid
  purpose      ConsentPurpose
  action       ConsentAction
  recordedById String?        @db.Uuid
  legalBasis   String?
  evidence     String?
  recordedAt   DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, purpose, recordedAt])
  @@map("consent_events")
}

model DsarRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @db.Uuid
  studentId   String?           @db.Uuid
  type        DsarRequestType
  status      DsarRequestStatus @default(RECEIVED)
  requestedBy String
  notes       String?
  completedAt DateTime?
  dueAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@map("dsar_requests")
}

/// Recorded before a side-effecting command runs. A repeated key returns the
/// stored response instead of re-applying the effect (section 11).
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @db.Uuid
  userId      String?  @db.Uuid
  scope       String
  key         String
  requestHash String
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  locale          String     @default("el")
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  mfaSecret       String?
  mfaEnabledAt    DateTime?
  mfaLastUsedStep Int?
  mfaFailedAttempts Int      @default(0)
  mfaLockedUntil  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships     Membership[]
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  teacherProfiles Teacher[]
  studentProfiles Student[]
  guardianProfiles Guardian[]
  lessonNotes     LessonNote[]
  markedAttendance Attendance[]
  announcements   Announcement[]
  notifications   Notification[]
  storedFiles     StoredFile[]
  chargesCreated  Charge[]       @relation("ChargeCreatedBy")
  paymentsRecorded Payment[]    @relation("PaymentRecordedBy")
  paymentsVoided  Payment[]      @relation("PaymentVoidedBy")
  examsCreated    Exam[]         @relation("ExamCreatedBy")
  examsPublished  Exam[]         @relation("ExamPublishedBy")
  resultsEntered  ExamResult[]   @relation("ResultEnteredBy")
  resultsApproved ExamResult[]   @relation("ResultApprovedBy")
  documentsIssued DocumentRecord[] @relation("DocumentIssuedBy")
  documentsPrepared DocumentRecord[] @relation("DocumentPreparedBy")
  documentsApproved DocumentRecord[] @relation("DocumentApprovedBy")
  examApplicationsDecided ExamApplication[] @relation("ApplicationDecidedBy")
  scholarshipsApproved Scholarship[] @relation("ScholarshipApprovedBy")
  supportGrants   SupportAccessGrant[] @relation("SupportGrantActor")
  assignmentsCreated Assignment[] @relation("AssignmentCreatedBy")
  submissionsGraded AssignmentSubmission[] @relation("SubmissionGradedBy")
  leadsAssigned   Lead[]           @relation("LeadAssignedTo")
  leadActivities  LeadActivity[]   @relation("LeadActivityActor")

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  tenantId  String         @db.Uuid
  role      MembershipRole
  branchId  String?        @db.Uuid
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Single-use password recovery token. Only the SHA-256 hash is stored, so a
/// database leak does not yield usable reset links.
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// One-time MFA recovery codes. Hashed at rest for the same reason as reset tokens.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

// ───────────────────────────── Academics ─────────────────────────────

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms         Room[]
  students      Student[]
  enrollments   Enrollment[]
  lessonSeries  LessonSeries[]
  lessons       Lesson[]
  memberships   Membership[]
  announcements Announcement[]
  calendarDays  CalendarDay[]
  leads         Lead[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("branches")
}

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  examPeriods ExamPeriod[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_years")
}

model Program {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  color     String?
  defaultFeeCents Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  lessonSeries LessonSeries[]
  exams       Exam[]
  assignments Assignment[]
  leads       Lead[]


  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("programs")
}

model Level {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  lessonSeries LessonSeries[]
  exams       Exam[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("levels")
}

model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String   @db.Uuid
  name      String
  capacity  Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@unique([tenantId, branchId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("rooms")
}

// ───────────────────────────── People ─────────────────────────────

model Teacher {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @db.Uuid
  userId     String?       @db.Uuid
  employeeNo String?
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  specialties String[]     @default([])
  bio        String?
  status     TeacherStatus @default(ACTIVE)
  deletedAt  DateTime?
  deletedById String?      @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lessonSeries LessonSeries[]
  lessons     Lesson[]
  enrollments Enrollment[]
  examCommittee ExamCommitteeMember[]
  assignments Assignment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, lastName])
  @@index([tenantId, deletedAt])
  @@map("teachers")
}

model Student {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @db.Uuid
  userId             String?       @db.Uuid
  branchId           String        @db.Uuid
  registrationNumber String
  firstName          String
  lastName           String
  birthDate          DateTime?     @db.Date
  gender             String?
  email              String?
  phone              String?
  address            String?
  city               String?
  notes              String?
  status             StudentStatus @default(ACTIVE)
  enrolledAt         DateTime      @default(now())
  consentData        Boolean       @default(false)
  consentMedia       Boolean       @default(false)
  deletedAt          DateTime?
  deletedById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch          Branch            @relation(fields: [branchId], references: [id])
  guardians       StudentGuardian[]
  enrollments     Enrollment[]
  lessonSeries    LessonSeriesStudent[]
  lessons         LessonStudent[]
  attendances     Attendance[]
  charges         Charge[]
  payments        Payment[]
  installmentPlans InstallmentPlan[]
  scholarships    Scholarship[]
  examApplications ExamApplication[]
  examResults     ExamResult[]
  documents       DocumentRecord[]
  consentEvents   ConsentEvent[]
  dsarRequests    DsarRequest[]
  assignmentTargets AssignmentTarget[]
  assignmentSubmissions AssignmentSubmission[]
  convertedFromLead Lead[] @relation("LeadConvertedStudent")

  @@unique([tenantId, registrationNumber])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, lastName])
  @@index([tenantId, deletedAt])
  @@map("students")
}

model Guardian {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  taxId     String?
  occupation String?
  consentRecordedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([tenantId, userId])
