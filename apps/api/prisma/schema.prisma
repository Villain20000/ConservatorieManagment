// ───────────────────────────── Learning ─────────────────────────────
// Assignments are per-student via AssignmentTarget; the submission row is
// created lazily on first submit, so `@@unique([assignmentId, studentId])`
// doubles as the "one submission per student" rule.

model Assignment {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  createdById    String           @db.Uuid
  teacherId      String?          @db.Uuid
  programId      String?          @db.Uuid
  lessonSeriesId String?          @db.Uuid
  title          String
  description    String?
  assignedOn     DateTime         @db.Date
  dueAt          DateTime?        @db.Timestamptz(3)
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  teacher     Teacher?         @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  program     Program?         @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  lessonSeries LessonSeries?   @relation(fields: [tenantId, lessonSeriesId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  targets     AssignmentTarget[]
  submissions AssignmentSubmission[]

  @@index([tenantId, status])
  @@index([tenantId, assignedOn])
  @@unique([tenantId, id])
  @@map("assignments")
}

model AssignmentTarget {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @db.Uuid
  assignmentId String @db.Uuid
  studentId    String @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  student    Student    @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
  @@map("assignment_targets")
}

model AssignmentSubmission {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  assignmentId String           @db.Uuid
  studentId    String           @db.Uuid
  status       SubmissionStatus @default(SUBMITTED)
  content      String?
  submittedAt  DateTime?
  grade        Int?
  feedback     String?
  gradedById   String?          @db.Uuid
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  student    Student    @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
  @@map("assignment_submissions")
}

// ───────────────────────────── Admissions CRM ─────────────────────────────
// A lead is the prospective student (child) plus the family contact. Conversion
// creates a real Student (+ optional Enrollment) and keeps the lead row for
// historical analytics, so no admission history is ever destroyed.

model Lead {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @db.Uuid
  branchId       String      @db.Uuid
  studentFirstName String
  studentLastName  String
  birthDate      DateTime?   @db.Date
  contactName    String
  contactEmail   String?
  contactPhone   String?
  relationship   String?
  source         LeadSource  @default(WEB_FORM)
  stage          LeadStage   @default(NEW)
  programId      String?     @db.Uuid
  notes          String?
  assignedToId   String?     @db.Uuid
  nextFollowUpAt DateTime?   @db.Timestamptz(3)
  lostReason     String?
  consentAt      DateTime?
  convertedStudentId String? @db.Uuid
  convertedAt    DateTime?
  deletedAt      DateTime?
  deletedById    String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  program     Program?       @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  assignedTo  User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedStudent Student?  @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  activities  LeadActivity[]

  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, deletedAt])
  @@unique([tenantId, id])
  @@map("leads")
}

model LeadActivity {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @db.Uuid
  leadId    String           @db.Uuid
  actorId   String?          @db.Uuid
  type      LeadActivityType
  fromStage LeadStage?
  toStage   LeadStage?
  body      String?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  actor  User?  @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}

model OutboxMessage {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String?      @db.Uuid
  dedupeKey     String       @unique
  type          String
  payloadJson   Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}
