DATABASE_URL="postgresql://musicos:musicos@localhost:5432/musicos?schema=public"
PORT=3000
WEB_ORIGIN=http://localhost:4200
NODE_ENV=development
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
