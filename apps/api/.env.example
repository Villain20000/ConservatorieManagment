DATABASE_URL="postgresql://musicos:musicos@localhost:5432/musicos?schema=public"
# Throwaway database replayed by Prisma when generating/validating migrations.
SHADOW_DATABASE_URL="postgresql://musicos:musicos@localhost:5432/musicos_shadow?schema=public"
PORT=3000
WEB_ORIGIN=http://localhost:4200
APP_PUBLIC_WEB_URL=http://localhost:4200
NODE_ENV=development
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
STORAGE_DIR=./var/storage
FONTS_DIR=./assets/fonts
SCHEDULER_ENABLED=true

# Mail — leave SMTP_URL empty to log messages instead of delivering them.
# Local development: `npm run mail:up` starts Mailpit on smtp://localhost:1025
SMTP_URL=
SMTP_FROM="MusicOS <no-reply@musicos.local>"
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_LOG_BODY=false

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3

# MFA — enforcement applies to platform admins, directors and administrators.
# Keep false in development and CI so the seeded demo accounts stay usable.
MFA_ENFORCE_PRIVILEGED=false
MFA_ISSUER=MusicOS
MFA_WINDOW=1

# Tenancy
TRIAL_GRACE_DAYS=7

# Observability
LOG_FORMAT=console
LOG_LEVEL=log
ERROR_REPORTER=log
